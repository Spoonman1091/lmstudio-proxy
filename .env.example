# Copy to `.env` (mode 600, never commit it) and fill in.
# Generate secrets with: openssl rand -hex 24   (LiteLLM keys must start with "sk-")

# The Mac's LAN IP (give it a DHCP reservation on your router).
LAN_IP=192.0.2.10

LITELLM_MASTER_KEY=sk-CHANGE_ME
LITELLM_SALT_KEY=sk-CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
WEBUI_SECRET_KEY=CHANGE_ME
# Create a LiteLLM key for Open WebUI after first start (see README), then paste it here.
OPENWEBUI_LITELLM_KEY=

# --- Reviewer (prompt monitoring + email alerts) ---
# IANA timezone, used for the daily digest hour (e.g. America/Chicago).
TZ=UTC
# Password for the read-only Postgres role `reviewer` (see README).
REVIEWER_DB_PASSWORD=CHANGE_ME
# Alerts are only emailed once SMTP_HOST, ALERT_FROM and ALERT_TO are all set;
# until then the reviewer runs in dry-run mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
# 1=mild 2=concerning 3=urgent. Alerts are emailed at or above this level.
ALERT_MIN_SEVERITY=2
DIGEST_HOUR=20
